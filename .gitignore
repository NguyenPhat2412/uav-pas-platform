# Incremental TypeScript compilation cache
*.tsbuildinfo

# Python interpreter cache
__pycache__/
*.py[cod]

# Claude Code local settings and worktrees
.claude/

# Edge AI models (large binaries; checksums in edge/kv260/README.md)
*.xmodel
