# Backend the app talks to. Defaults to production when unset.
# For the backend on this Mac: `npm run lan` writes .env.development.local with your Wi-Fi address
# (the iOS Simulator can also use http://localhost:8080).
EXPO_PUBLIC_API_URL=https://api.uav.all1.vn

# Google Sign-In (optional; the button is hidden until both are set).
# WEB client ID: the same OAuth client the website uses (backend GOOGLE_CLIENT_ID); it is the ID token audience.
# iOS client ID: an "iOS" OAuth client for bundle ID vn.all1.uavpas. Changing it needs a new native build.
# EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=1234567890-xxxx.apps.googleusercontent.com
# EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=1234567890-yyyy.apps.googleusercontent.com
