  "newRegressionCases": [
    "Reject confirmed mission with UAV and multiple equipment reservations: release each once; rejected retry leaves persisted state, inventory ledger, event and audit unchanged.",
    "Reject pending mission before assignment: stock untouched.",
    "Reject RESOURCE_RESERVED mission: MISSION_INVALID_STATUS; all resources, quantities, versions and history unchanged.",
    "Injected audit persistence failure: rejection, equipment release, reservation released flags, UAV release and timeline all roll back in the same Spring transaction."
  ],
  "coverageLimitations": [
    "New regression tests use isolated H2 with real Spring transactions, repositories and services; only the last audit write is fault-injected for the rollback test.",
    "Full suite includes actual PostgreSQL stabilization/migration and real MinIO lifecycle. Parent is separately testing UI and the resource-release behavior on PostgreSQL runtime.",
    "No auth contract changes. No change to operator acceptance policy, UAV assignment station policy or reassignment policy."
  ],
  "timelineNoteBoundary": {
    "reproduction": "Real Spring/JPA persistence rejects 501-character reject, conflict and completion notes with DataIntegrityViolationException from mission_events.description varchar(500). All related state rolls back.",
    "acceptedBoundary": 500,
    "cases": 3,
    "result": "PASS",
    "uiMitigation": "Operations primary note textarea and service guards now limit all timeline note payloads to 500 characters. failureNotes remains 2000; equipmentCondition remains 500. Backend API/schema/auth contract unchanged."
  }
