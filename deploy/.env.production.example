# UAV PAS production settings for deploy/docker-compose.prod.yml.
# One origin: https://uav.all1.vn serves the web app, https://uav.all1.vn/api/** the backend.

# --- PostgreSQL (internal to the compose network) ---
POSTGRES_DB=uav_pas
POSTGRES_USER=uav_pas
POSTGRES_PASSWORD=replace-with-a-long-random-password

# --- Backend ---
APP_JWT_SECRET=replace-with-48-random-bytes
HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
APP_CORS_ALLOWED_ORIGINS=https://uav.all1.vn
APP_COOKIE_SECURE=true
APP_COOKIE_SAME_SITE=Lax
# Empty = host-only cookies for uav.all1.vn (not shared with other *.all1.vn sites).
APP_COOKIE_DOMAIN=
APP_BILLING_PROVIDER_ENABLED=false
APP_BILLING_IPN_SECRET=replace-with-a-random-secret

# --- Media storage: Cloudflare R2 ---
APP_STORAGE_PROVIDER=r2
APP_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
APP_STORAGE_BUCKET=uavpas
APP_STORAGE_ACCESS_KEY=replace-with-r2-access-key-id
APP_STORAGE_SECRET_KEY=replace-with-r2-secret-access-key
APP_STORAGE_REGION=auto
APP_STORAGE_ENSURE_BUCKET=false
APP_STORAGE_CORS_ORIGIN=https://uav.all1.vn

# --- Frontend (compiled into the bundle at build time) ---
NEXT_PUBLIC_API_URL=https://uav.all1.vn
NEXT_PUBLIC_APP_URL=https://uav.all1.vn
# Staffed 24/7 dispatch number; leave empty to hide the call button.
NEXT_PUBLIC_DISPATCH_HOTLINE=
# Google sign-in: the OAuth Web client ID (public). The backend's GOOGLE_CLIENT_ID must hold the same value.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Host ports (bound to 127.0.0.1; nginx proxies to them) ---
BACKEND_PORT=18080
FRONTEND_PORT=13100

# Never true outside a developer machine: it echoes OTP codes in API responses and logs.
APP_AUTH_OTP_DEV_PREVIEW=false

# --- Outbound email (OTP, 2FA, password reset). Admin > Infrastructure > Email shows only flags, never these values ---
APP_MAIL_ENABLED=false
APP_MAIL_FROM=no-reply@uav.all1.vn
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_AUTH=true
SMTP_STARTTLS=true

# --- Admin > Infrastructure (optional) ---
# Public origin for the TLS expiry check; docker-compose.prod.yml falls back to NEXT_PUBLIC_APP_URL.
APP_PUBLIC_URL=https://uav.all1.vn
# Host folder of the daily pg_dump (DEPLOY.md section 9); mounted read-only into the backend at /backups.
BACKUP_HOST_DIR=/opt/uav-pas/backups
APP_BACKUP_STALE_AFTER_HOURS=36
# APP_VERSION / APP_GIT_COMMIT / APP_BUILD_TIME are set by the build command (DEPLOY.md section 8), not here.

# --- Sign in with Google (optional) ---
# OAuth web client ID(s), comma-separated; must match the frontend button. Empty disables POST /api/v1/auth/google (503).
GOOGLE_CLIENT_ID=
