# UAV PAS Staging settings for deploy/docker-compose.ghcr.yml.
# Copy to /opt/uav-pas-staging/deploy/.env.staging on the VPS and chmod 600.
#
# Uses uav-staging.all1.vn (single-level subdomain under *.all1.vn) so both Cloudflare Universal SSL
# and Let's Encrypt work without multi-level wildcard certificate errors, and binds isolated host ports
# (28080 / 23100) so Staging and Production can run safely side-by-side on one VPS or on separate servers.

# --- PostgreSQL (isolated uav-pas-staging compose network & volume) ---
POSTGRES_DB=uav_pas_staging
POSTGRES_USER=uav_pas_staging
POSTGRES_PASSWORD=replace-with-a-long-random-staging-password

# --- Backend ---
APP_JWT_SECRET=replace-with-48-random-bytes-distinct-from-production
HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false
APP_CORS_ALLOWED_ORIGINS=https://uav-staging.all1.vn
APP_COOKIE_SECURE=true
APP_COOKIE_SAME_SITE=Lax
APP_COOKIE_DOMAIN=uav-staging.all1.vn
APP_BILLING_PROVIDER_ENABLED=false
APP_BILLING_IPN_SECRET=replace-with-a-random-staging-secret

# --- Media storage: separate Staging bucket on Cloudflare R2 ---
APP_STORAGE_PROVIDER=r2
APP_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
APP_STORAGE_BUCKET=uavpas-staging
APP_STORAGE_ACCESS_KEY=replace-with-staging-r2-access-key-id
APP_STORAGE_SECRET_KEY=replace-with-staging-r2-secret-access-key
APP_STORAGE_REGION=auto
APP_STORAGE_ENSURE_BUCKET=false
APP_STORAGE_CORS_ORIGIN=https://uav-staging.all1.vn

# --- Frontend (also configure matching GitHub Environment 'staging' variables for GHCR build) ---
NEXT_PUBLIC_API_URL=https://uav-staging.all1.vn
NEXT_PUBLIC_APP_URL=https://uav-staging.all1.vn
NEXT_PUBLIC_DISPATCH_HOTLINE=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Isolated Host Ports (bound to 127.0.0.1; nginx uav-staging.all1.vn.conf proxies to them) ---
BACKEND_PORT=28080
FRONTEND_PORT=23100

# Keep OTP preview disabled on any internet-reachable staging server.
APP_AUTH_OTP_DEV_PREVIEW=false
APP_AUTH_ALLOWED_EMAIL_DOMAINS=gmail.com,googlemail.com,outlook.com,outlook.com.vn,hotmail.com,live.com,msn.com,icloud.com,me.com,mac.com,yahoo.com,yahoo.com.vn,proton.me,protonmail.com,zoho.com,.edu.vn,.ac.vn,.gov.vn,.edu,.ac.jp
APP_AUTH_BLOCKED_EMAIL_DOMAINS=
APP_AUTH_OTP_PER_ACCOUNT=5
APP_AUTH_OTP_PER_IP=15
APP_AUTH_MAX_EMAILS_PER_MINUTE=15
APP_AUTH_MAX_SIGNED_IN_EMAILS_PER_MINUTE=60
APP_AUTH_OTP_COOLDOWN_SECONDS=30

# --- Outbound email (optional on Staging) ---
APP_MAIL_ENABLED=false
APP_MAIL_FROM=no-reply@uav.all1.vn
SMTP_HOST=replace-with-smtp-host
SMTP_PORT=587
SMTP_USERNAME=replace-with-smtp-username
SMTP_PASSWORD=replace-with-smtp-password
SMTP_AUTH=true
SMTP_STARTTLS=true

# --- Admin > Infrastructure ---
APP_PUBLIC_URL=https://uav-staging.all1.vn
BACKUP_HOST_DIR=/opt/uav-pas-staging/backups
APP_BACKUP_STALE_AFTER_HOURS=36

# --- Sign in with Google & Hardening ---
GOOGLE_CLIENT_ID=
APP_SHOW_SQL=false
APP_API_DOCS_ENABLED=false
