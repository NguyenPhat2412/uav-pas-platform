SPRING_PROFILES_ACTIVE=docker
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/uav_pas_dev
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me-local
APP_JWT_SECRET=replace-with-a-random-32-byte-secret

# Read docs/architecture/BACKEND_DATABASE_MIGRATIONS.md before adopting a legacy DB.
HIBERNATE_DDL_AUTO=validate
SPRING_FLYWAY_ENABLED=true
SPRING_FLYWAY_BASELINE_ON_MIGRATE=false

# Media storage. Local default is MinIO; production uses Cloudflare R2 (S3-compatible).
APP_STORAGE_PROVIDER=r2
APP_STORAGE_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
APP_STORAGE_BUCKET=uavpas
APP_STORAGE_ACCESS_KEY=replace-with-r2-access-key-id
APP_STORAGE_SECRET_KEY=replace-with-r2-secret-access-key
APP_STORAGE_REGION=auto
APP_STORAGE_ENSURE_BUCKET=false
APP_STORAGE_CORS_ORIGIN=https://uav.all1.vn
APP_STORAGE_CDN_URL=https://cdn.uav.all1.vn

# Sign in with Google: OAuth web client ID(s) from Google Cloud Console, comma-separated. Empty disables it.
GOOGLE_CLIENT_ID=

# Allowed email domains/suffixes for registration & OTP (leading dot matches subdomains; * allows any non-blocked domain).
APP_AUTH_ALLOWED_EMAIL_DOMAINS=gmail.com,googlemail.com,outlook.com,outlook.com.vn,hotmail.com,live.com,msn.com,icloud.com,me.com,mac.com,yahoo.com,yahoo.com.vn,proton.me,protonmail.com,zoho.com,vju.ac.vn,vnu.edu.vn,.edu.vn,.ac.vn,.gov.vn,.edu,.ac.jp
APP_AUTH_BLOCKED_EMAIL_DOMAINS=
APP_AUTH_OTP_PER_ACCOUNT=3
APP_AUTH_OTP_PER_IP=8
APP_AUTH_MAX_EMAILS_PER_MINUTE=15
APP_AUTH_MAX_SIGNED_IN_EMAILS_PER_MINUTE=60
APP_AUTH_OTP_COOLDOWN_SECONDS=60
# Print every SQL statement (debugging only).
APP_SHOW_SQL=false
# OpenAPI / Swagger UI for local development (production sets false).
APP_API_DOCS_ENABLED=true
