      "codes": {
        "OTP_DEV_PREVIEW_ENABLED": {
          "title": "OTP preview is on",
          "fix": "OTP leaks in API and logs. Set APP_AUTH_OTP_DEV_PREVIEW=false."
        },
        "COOKIE_SAMESITE_NONE_INSECURE": {
          "title": "SameSite=None without Secure",
          "fix": "Cookie gets rejected. Set APP_COOKIE_SECURE=true or SameSite=Lax."
        },
        "COOKIE_NOT_SECURE": {
          "title": "Cookie not Secure",
          "fix": "Cookie may travel over HTTP. Set APP_COOKIE_SECURE=true."
        },
        "CORS_WILDCARD": {
          "title": "CORS allows any origin (*)",
          "fix": "List exact domains in APP_CORS_ALLOWED_ORIGINS."
        },
        "CORS_LOCALHOST": {
          "title": "CORS allows localhost",
          "fix": "Remove localhost from APP_CORS_ALLOWED_ORIGINS."
        },
        "CORS_PLAIN_HTTP": {
          "title": "CORS allows HTTP origins",
          "fix": "Use only https:// in APP_CORS_ALLOWED_ORIGINS."
        },
        "MAIL_DISABLED": {
          "title": "Email sending off",
          "fix": "OTP emails won't send. Configure SMTP, set APP_MAIL_ENABLED=true."
        },
        "ACCESS_TOKEN_LONG_LIVED": {
          "title": "Access token over 24 hours",
          "fix": "Lower APP_JWT_EXPIRATION_MS to 15–60 minutes."
        },
        "REFRESH_TOKEN_LONG_LIVED": {
          "title": "Refresh token over 30 days",
          "fix": "Consider lowering app.jwt.refresh-expiration-ms."
        },
        "NOT_PRODUCTION_PROFILE": {
          "title": "Not detected as production",
          "fix": "If this is production, check deploy/.env.production."
        },
        "SECRET_MISSING": {
          "title": "Required secret missing",
          "fix": "Set a long random value, then restart."
        },
        "SECRET_KNOWN_DEFAULT": {
          "title": "Secret uses a default value",
          "fix": "Treat as leaked. Replace with a new random value."
        },
        "SECRET_TOO_SHORT": {
          "title": "Secret too short",
          "fix": "Generate: openssl rand -base64 48."
        }
      }
