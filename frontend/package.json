{
  "name": "uav-pas-platform",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "npm run lint --workspaces",
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm run test --workspaces",
    "build": "npm run build --workspaces",
    "dev": "npm run dev --prefix legacy",
    "start": "npm run start --prefix legacy",
    "dev:web": "npm run dev --workspace=@uav/web",
    "dev:customer": "npm run dev --workspace=@uav/customer",
    "dev:operations": "npm run dev --workspace=@uav/operations",
    "dev:admin": "npm run dev --workspace=@uav/admin",
    "lint:legacy": "npm run lint --prefix legacy",
    "typecheck:legacy": "npm run typecheck --prefix legacy",
    "test:legacy": "npm test --prefix legacy",
    "build:legacy": "npm run build --prefix legacy",
    "dev:unified": "npm --prefix legacy run dev",
    "test:e2e": "node tests/e2e/mission.mjs",
    "test:contracts": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "typescript": "^5",
    "playwright": "1.63.0"
  }
}
