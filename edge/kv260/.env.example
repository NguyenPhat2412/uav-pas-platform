# ==============================================================================
# Cấu hình Edge Agent cho Xilinx Kria KV260 (Ubuntu 22.04 LTS / Vitis AI 3.0)
# Sao chép tệp này thành .env hoặc /etc/uav-kv260/agent.env trước khi chạy
# ==============================================================================

# Địa chỉ gốc của Spring Boot Backend (HTTPS khuyến nghị khi bay qua 4G/LTE)
UAV_API_BASE_URL=https://api.uav-pas.example.com

# Khóa thiết bị cấp từ trang Quản trị (scope TELEMETRY_WRITE, gửi qua header X-Device-Key)
UAV_DEVICE_KEY=uav_dk_replace_with_real_device_key

# JWT Bearer của tài khoản dịch vụ biên (cần quyền UAV_UPDATE, MISSION_VIEW, MEDIA_UPLOAD, MEDIA_DOWNLOAD cho AI & Media)
UAV_BEARER_TOKEN=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.replace_with_service_token

# Định danh UAV và mã nhiệm vụ tìm kiếm cứu nạn / khảo sát hiện hành (tùy chọn)
UAV_ID=1
MISSION_ID=

# Nguồn MAVLink v2 từ bộ điều khiển bay PX4 / ArduPilot:
#   - UDP qua mạng nội bộ companion: udpin:0.0.0.0:14550
#   - UART trực tiếp trên chân PMOD/MIO KV260: /dev/ttyPS1:921600 hoặc /dev/ttyUSB0:57600
MAVLINK_ENDPOINT=udpin:0.0.0.0:14550

# Tần suất đẩy mẫu telemetry lên Backend (Hz) và chu kỳ hỏi tác vụ AI (giây)
TELEMETRY_HZ=2.0
AI_POLL_INTERVAL_SEC=2.0
SPOOL_FLUSH_INTERVAL_SEC=5.0
TELEMETRY_USE_UTC=false

# Hàng đợi lưu trữ ngoại tuyến SQLite3 WAL khi mất sóng 4G/LTE giữa chuyến bay
SPOOL_DB_PATH=/var/lib/uav-kv260/offline_spool.db
SPOOL_MAX_ROWS=10000

# Cấu hình kết nối HTTP & chứng chỉ TLS
HTTP_TIMEOUT_SEC=8.0
UAV_TLS_VERIFY=true
UAV_TLS_CA_BUNDLE=

# Tệp mô hình Vitis AI (.xmodel) biên dịch cho DPUCZDX8G B3136 trên KV260
MODEL_PATH=models/yolov8_human_kv260_b3136.xmodel
# Để trống để tự động đối chiếu bảng băm chuẩn của KV260, hoặc chỉ định rõ SHA-256:
MODEL_EXPECTED_SHA256=c10bd89ab28ec4b4797a5a96949b8c591367ffb9b4fa7d4f33f34dbb2d75a09e

# Nguồn hình ảnh camera (MIPI/USB V4L2 hoặc luồng RTSP từ gimbal IP) & thông số quang học
CAMERA_RTSP_OR_DEV=/dev/video0
CAMERA_HFOV_DEG=78.0
CAMERA_VFOV_DEG=48.0
GIMBAL_PITCH_DEG=-90.0

# Ngưỡng phát hiện đối tượng và lọc chồng lấp NMS
AI_CONFIDENCE_THRESHOLD=0.45
AI_NMS_IOU_THRESHOLD=0.45
