NEXT_PUBLIC_API_URL=http://localhost:18082
NEXT_PUBLIC_APP_URL=http://localhost:3100
NEXT_PUBLIC_ENVIRONMENT=local
# Staffed 24/7 dispatch number shown to customers (e.g. +84 24 0000 0000); unset hides the button.
NEXT_PUBLIC_DISPATCH_HOTLINE=
# Google sign-in: OAuth Web client ID from Google Cloud Console (same value as the backend's GOOGLE_CLIENT_ID).
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
# Apple sign-in: Apple Developer Services ID (e.g. vn.all1.uavpas.web) and verified HTTPS Return URL.
NEXT_PUBLIC_APPLE_CLIENT_ID=
NEXT_PUBLIC_APPLE_REDIRECT_URI=
# Production only: swallow F12 / Ctrl+Shift+I / Ctrl+U shortcuts (a deterrent, not security). 'off' disables it.
NEXT_PUBLIC_DEVTOOLS_GUARD=on
